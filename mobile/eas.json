{
  "cli": {
    "version": ">= 16.12.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "development",
        "EXPO_PUBLIC_API_URL": "https://api.oov.digital/api"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "autoIncrement": "versionCode",
        "buildType": "apk",
        "applicationArchivePath": "android/app/build/outputs/apk/release/app-release.apk"
      },
      "env": {
        "APP_VARIANT": "preview",
        "EXPO_PUBLIC_API_URL": "https://api.oov.digital/api"
      }
    },
    "production": {
      "ios": {
        "autoIncrement": "buildNumber",
        "image": "latest"
      },
      "android": {
        "autoIncrement": "versionCode"
      },
      "env": {
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_API_URL": "https://api.oov.digital/api"
      }
    },
    "production_test": {
      "distribution": "internal",
      "android": {
        "autoIncrement": "versionCode",
        "buildType": "app-bundle"
      },
      "env": {
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_API_URL": "https://api.oov.digital/api",
        "SENTRY_AUTH_TOKEN": "none"
      }
    },
    "debug_production": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_API_URL": "https://api.oov.digital/api",
        "SENTRY_AUTH_TOKEN": "none"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6783906612"
      },
      "android": {
        "track": "internal"
      }
    }
  }
}
